uien": "MEGAFONIA"}, {"texto": "el", "inicio": 67.58, "fin": 67.638, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "sistema", "inicio": 67.696, "fin": 68.068, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "se", "inicio": 68.126, "fin": 68.219, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "ha", "inicio": 68.253, "fin": 68.3, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "restablecido…", "inicio": 68.358, "fin": 69.31, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "…y", "inicio": 69.47, "fin": 69.83, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "de", "inicio": 69.888, "fin": 69.946, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "que", "inicio": 70.004, "fin": 70.085, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "el", "inicio": 70.12, "fin": 70.178, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "horario", "inicio": 70.225, "fin": 70.527, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "de", "inicio": 70.573, "fin": 70.619, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "atención", "inicio": 70.654, "fin": 71.026, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "termina", "inicio": 71.084, "fin": 71.432, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "ahora.", "inicio": 71.455, "fin": 71.885, "tipo": "word", "quien": "MEGAFONIA"}, {"texto": "Hasta", "inicio": 72.045, "fin": 72.428, "tipo": "word", "quien": "VETERANO"}, {"texto": "mañana,", "inicio": 72.475, "fin": 72.823, "tipo": "word", "quien": "VETERANO"}, {"texto": "compañero.", "inicio": 72.846, "fin": 73.67, "tipo": "word", "quien": "VETERANO"}], "frases": [{"quien": "MEGAFONIA", "texto": "Les informamos de que se ha caído el sistema.", "inicio": 0.25, "fin": 2.833}, {"quien": "ROSA", "texto": "¿Se ha caído el sistema? ¿Y ahora qué?", "inicio": 2.993, "fin": 5.176}, {"quien": "VETERANO", "texto": "Ahora nada. Se cae todos los días a esta hora. Es su rato de descanso.", "inicio": 5.336, "fin": 10.862}, {"quien": "ROSA", "texto": "Yo tengo el A cuatrocientos doce.", "inicio": 11.022, "fin": 12.648}, {"quien": "VETERANO", "texto": "Qué suerte. Yo tengo el B siete, del sistema antiguo. Ya no lo cantan ni las máquinas.", "inicio": 12.808, "fin": 18.891}, {"quien": "ROSA", "texto": "Si solo vengo a renovar el DNI…", "inicio": 19.051, "fin": 21.188}, {"quien": "VETERANO", "texto": "Para renovarlo necesitas el DNI en vigor.", "inicio": 21.348, "fin": 24.506}, {"quien": "ROSA", "texto": "Pero está caducado, por eso lo renuevo.", "inicio": 24.666, "fin": 26.57}, {"quien": "VETERANO", "texto": "Entonces necesitas cita. Y para pedir la cita, el DNI. Bienvenido.", "inicio": 26.73, "fin": 32.256}, {"quien": "ROSA", "texto": "¿Y esa señora con el táper?", "inicio": 32.416, "fin": 33.995}, {"quien": "VETERANO", "texto": "Vino a pedir la jubilación. Se la concedieron aquí mismo, esperando. Ya cobra.", "inicio": 34.155, "fin": 39.542}, {"quien": "ROSA", "texto": "Bueno, pues pregunto en información.", "inicio": 39.702, "fin": 41.745}, {"quien": "VETERANO", "texto": "Para información también hay que coger número. Y el número se pide por internet.", "inicio": 41.905, "fin": 46.596}, {"quien": "ROSA", "texto": "¿Y la web?", "inicio": 46.756, "fin": 47.731}, {"quien": "VETERANO", "texto": "Abre los martes a las ocho y cinco. Dura cuatro segundos. Como las entradas de un concierto.", "inicio": 47.891, "fin": 54.067}, {"quien": "ROSA", "texto": "Pues me espero.", "inicio": 54.227, "fin": 55.156}, {"quien": "VETERANO", "texto": "Saca antes el tique de espera, que esperar sin número es colarse.", "inicio": 55.316, "fin": 59.078}, {"quien": "SENOR", "texto": "Perdona, ¿la mesa cuatro atiende?", "inicio": 59.238, "fin": 61.653}, {"quien": "VETERANO", "texto": "La mesa cuatro es un póster, Paco. Lleva ahí desde dos mil diecinueve.", "inicio": 61.813, "fin": 66.41}, {"quien": "MEGAFONIA", "texto": "Les informamos de que el sistema se ha restablecido…", "inicio": 66.57, "fin": 69.31}, {"quien": "MEGAFONIA", "texto": "…y de que el horario de atención termina ahora.", "inicio": 69.47, "fin": 71.885}, {"quien": "VETERANO", "texto": "Hasta mañana, compañero.", "inicio": 72.045, "fin": 73.671}]}