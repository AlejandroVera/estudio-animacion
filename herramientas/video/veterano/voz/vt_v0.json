"frases": [
{
"quien": "MEGAFONIA",
"texto": "Número A cero cero tres, mesa dos. Les informamos de que se ha caído el sistema.",
"inicio": 0.0,
"fin": 4.365
},
{
"quien": "ROSA",
"texto": "¿Se ha caído el sistema? ¿Y ahora qué?",
"inicio": 4.525,
"fin": 6.708
},
{
"quien": "VETERANO",
"texto": "Ahora nada. Se cae todos los días a esta hora. Es su rato de descanso.",
"inicio": 6.868,
"fin": 12.394
},
{
"quien": "ROSA",
"texto": "Yo tengo el A cuatrocientos doce.",
"inicio": 12.554,
"fin": 14.18
},
{
"quien": "VETERANO",
"texto": "Qué suerte. Yo tengo el B siete, del sistema antiguo. Ya no lo cantan ni las máquinas.",
"inicio": 14.34,
"fin": 20.423
},
{
"quien": "ROSA",
"texto": "Si solo vengo a renovar el DNI…",
"inicio": 20.583,
"fin": 22.72
},
{
"quien": "VETERANO",
"texto": "Para renovarlo necesitas el DNI en vigor.",
"inicio": 22.88,
"fin": 26.038
},
{
"quien": "ROSA",
"texto": "Pero está caducado, por eso lo renuevo.",
"inicio": 26.198,
"fin": 28.102
},
{
"quien": "VETERANO",
"texto": "Entonces necesitas cita. Y para pedir la cita, el DNI. Bienvenido.",
"inicio": 28.262,
"fin": 33.788
},
{
"quien": "ROSA",
"texto": "¿Y esa señora con el táper?",
"inicio": 33.948,
"fin": 35.527
},
{
"quien": "VETERANO",
"texto": "Vino a pedir la jubilación. Se la concedieron aquí mismo, esperando. Ya cobra.",
"inicio": 35.687,
"fin": 41.074
},
{
"quien": "ROSA",
"texto": "Bueno, pues pregunto en información.",
"inicio": 41.234,
"fin": 43.277
},
{
"quien": "VETERANO",
"texto": "Para información también hay que coger número. Y el número se pide por internet.",
"inicio": 43.437,
"fin": 48.128
},
{
"quien": "ROSA",
"texto": "¿Y la web?",
"inicio": 48.288,
"fin": 49.263
},
{
"quien": "VETERANO",
"texto": "Abre los martes a las ocho y cinco. Dura cuatro segundos. Como las entradas de un concierto.",
"inicio": 49.423,
"fin": 55.599
},
{
"quien": "ROSA",
"texto": "Pues me espero.",
"inicio": 55.759,
"fin": 56.688
},
{
"quien": "VETERANO",
"texto": "Saca antes el tique de espera, que esperar sin número es colarse.",
"inicio": 56.848,
"fin": 60.61
},
{
"quien": "SENOR",
"texto": "Perdona, ¿la mesa cuatro atiende?",
"inicio": 60.77,
"fin": 63.185
},
{
"quien": "VETERANO",
"texto": "La mesa cuatro es un póster, Paco. Lleva ahí desde dos mil diecinueve.",
"inicio": 63.345,
"fin": 67.942
},
{
"quien": "MEGAFONIA",
"texto": "Les informamos de que el sistema se ha restablecido…",
"inicio": 68.102,
"fin": 70.842
},
{
"quien": "MEGAFONIA",
"texto": "…y de que el horario de atención termina ahora.",
"inicio": 71.002,
"fin": 73.417
},
{
"quien": "VETERANO",
"texto": "Hasta mañana, compañero.",
"inicio": 73.577,
"fin": 75.203
}
]
}