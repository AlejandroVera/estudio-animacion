"frases": [
{
"quien": "AGENTE",
"texto": "Pues este es el piso. Bienvenido a tu nuevo hogar.",
"inicio": 0.0,
"fin": 2.95
},
{
"quien": "ROSA",
"texto": "¿Por qué tengo que estar agachado?",
"inicio": 3.11,
"fin": 5.525
},
{
"quien": "AGENTE",
"texto": "Techos con personalidad. Es una buhardilla, muy de París.",
"inicio": 5.685,
"fin": 9.691
},
{
"quien": "ROSA",
"texto": "Me acabo de dar con la viga.",
"inicio": 9.851,
"fin": 11.291
},
{
"quien": "AGENTE",
"texto": "Eso es el encanto. Seiscientos cincuenta al mes, gastos aparte.",
"inicio": 11.451,
"fin": 15.331
},
{
"quien": "ROSA",
"texto": "¿Y la ducha?",
"inicio": 15.491,
"fin": 16.42
},
{
"quien": "AGENTE",
"texto": "Ducha sentado. Como un spa.",
"inicio": 16.58,
"fin": 18.276
},
{
"quien": "ROSA",
"texto": "¿Y la cocina?",
"inicio": 18.436,
"fin": 19.412
},
{
"quien": "AGENTE",
"texto": "De rodillas. Así quedas a la altura de los fogones. Ergonomía.",
"inicio": 19.572,
"fin": 23.776
},
{
"quien": "ROSA",
"texto": "Esto es un trastero.",
"inicio": 23.936,
"fin": 25.375
},
{
"quien": "AGENTE",
"texto": "No, no, no. El trastero es el de abajo, y cuesta setecientos. Esto es un loft.",
"inicio": 25.535,
"fin": 30.79
},
{
"quien": "ROSA",
"texto": "¿Un loft de metro veinte?",
"inicio": 30.95,
"fin": 32.297
},
{
"quien": "AGENTE",
"texto": "Un mini loft. Ahora se lleva todo mini.",
"inicio": 32.457,
"fin": 35.932
},
{
"quien": "ROSA",
"texto": "¿Y si vienen amigos?",
"inicio": 36.092,
"fin": 37.3
},
{
"quien": "AGENTE",
"texto": "Que vengan agachados, que es más íntimo.",
"inicio": 37.46,
"fin": 39.893
},
{
"quien": "ROSA",
"texto": "Me lo tengo que pensar.",
"inicio": 40.053,
"fin": 41.306
},
{
"quien": "AGENTE",
"texto": "Tienes hasta las cinco. Hay veinte interesados esperando en la escalera.",
"inicio": 41.466,
"fin": 45.384
}
]
