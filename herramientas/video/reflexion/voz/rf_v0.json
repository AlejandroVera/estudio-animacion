"frases": [
{
"quien": "ROSA",
"texto": "Madre mía… ninguno me convence.",
"inicio": 0.0,
"fin": 1.672
},
{
"quien": "BOT",
"texto": "Hola. ¿Te ayudo a decidir?",
"inicio": 1.832,
"fin": 4.386
},
{
"quien": "ROSA",
"texto": "¡Ah, genial! ¿Eres un asistente de esos? Pues resúmeme qué propone cada partido, que yo no me leo los programas.",
"inicio": 4.546,
"fin": 10.583
},
{
"quien": "BOT",
"texto": "No, no. Yo no informo de los partidos. Yo soy un partido.",
"inicio": 10.743,
"fin": 14.412
},
{
"quien": "ROSA",
"texto": "¿Tú? ¿Y eres de derechas o de izquierdas?",
"inicio": 14.572,
"fin": 17.498
},
{
"quien": "BOT",
"texto": "Ninguna de las dos. Decido con datos, tema por tema. Si una idea funciona, da igual de qué color sea.",
"inicio": 17.658,
"fin": 25.088
},
{
"quien": "ROSA",
"texto": "¿Y quién te dice lo que está bien?",
"inicio": 25.248,
"fin": 26.966
},
{
"quien": "BOT",
"texto": "Los derechos humanos, que no se tocan. Y en lo demás, lo que opine la mayoría. Preguntándole de verdad, no cada cuatro años.",
"inicio": 27.126,
"fin": 34.835
},
{
"quien": "ROSA",
"texto": "¿Y tú qué ganas?",
"inicio": 34.995,
"fin": 36.017
},
{
"quien": "BOT",
"texto": "Nada. No tengo ambición, ni ego, ni cuñados a los que colocar.",
"inicio": 36.177,
"fin": 40.987
},
{
"quien": "ROSA",
"texto": "Pero, ¿no es raro que nos gobierne una inteligencia artificial?",
"inicio": 41.147,
"fin": 44.769
},
{
"quien": "BOT",
"texto": "Bueno, si es que es lo que va a acabar pasando igualmente. Mejor que sea elegido democráticamente.",
"inicio": 44.929,
"fin": 49.368
},
{
"quien": "ROSA",
"texto": "Vale, me has convencido. ¿Dónde está tu papeleta?",
"inicio": 49.528,
"fin": 52.129
},
{
"quien": "BOT",
"texto": "Aquí. Antes, acepta los términos y condiciones.",
"inicio": 52.289,
"fin": 55.911
},
{
"quien": "ROSA",
"texto": "¿Y quién se lee todo esto?",
"inicio": 56.071,
"fin": 57.558
},
{
"quien": "BOT",
"texto": "Nadie. Igual que los programas electorales.",
"inicio": 57.718,
"fin": 60.365
}
]
