po": "word", "quien": "BOT"}, {"texto": "Igual", "inicio": 61.114, "fin": 61.405, "tipo": "word", "quien": "BOT"}, {"texto": "que", "inicio": 61.451, "fin": 61.521, "tipo": "word", "quien": "BOT"}, {"texto": "los", "inicio": 61.556, "fin": 61.66, "tipo": "word", "quien": "BOT"}, {"texto": "programas", "inicio": 61.706, "fin": 62.09, "tipo": "word", "quien": "BOT"}, {"texto": "electorales.", "inicio": 62.136, "fin": 63.078, "tipo": "word", "quien": "BOT"}], "frases": [{"quien": "ROSA", "texto": "Madre mía… ninguno me convence.", "inicio": 3.8, "fin": 5.472}, {"quien": "BOT", "texto": "Hola. ¿Te ayudo a decidir?", "inicio": 5.632, "fin": 7.596}, {"quien": "ROSA", "texto": "¡Ah, genial! ¿Eres un asistente de esos? Pues resúmeme qué propone cada partido, que yo no me leo los programas.", "inicio": 7.756, "fin": 13.473}, {"quien": "BOT", "texto": "No, no. Yo no informo de los partidos. Yo soy un partido.", "inicio": 13.633, "fin": 17.292}, {"quien": "ROSA", "texto": "¿Tú? ¿Y eres de derechas o de izquierdas?", "inicio": 17.452, "fin": 19.998}, {"quien": "BOT", "texto": "Ninguna de las dos. Decido con datos, tema por tema. Si una idea funciona, da igual de qué color sea.", "inicio": 20.158, "fin": 26.928}, {"quien": "ROSA", "texto": "¿Y quién te dice lo que está bien?", "inicio": 27.088, "fin": 28.806}, {"quien": "BOT", "texto": "Los derechos humanos, que no se tocan. Y en lo demás, lo que opine la mayoría. Preguntándole de verdad, no cada cuatro años.", "inicio": 28.966, "fin": 36.675}, {"quien": "ROSA", "texto": "¿Y tú qué ganas?", "inicio": 36.835, "fin": 37.857}, {"quien": "BOT", "texto": "Nada. No tengo ambición, ni ego, ni cuñados a los que colocar.", "inicio": 38.017, "fin": 42.377}, {"quien": "ROSA", "texto": "Pero, ¿no es raro que nos gobierne una inteligencia artificial?", "inicio": 42.537, "fin": 45.889}, {"quien": "BOT", "texto": "Bueno… si es que es lo que va a acabar pasando igualmente… Mejor que sea elegido democráticamente.", "inicio": 46.049, "fin": 52.151}, {"quien": "ROSA", "texto": "Vale, me has convencido. ¿Dónde está tu papeleta?", "inicio": 52.311, "fin": 54.912}, {"quien": "BOT", "texto": "Aquí. Antes, acepta los términos y condiciones.", "inicio": 55.072, "fin": 58.634}, {"quien": "ROSA", "texto": "¿Y quién se lee todo esto?", "inicio": 58.794, "fin": 60.281}, {"quien": "BOT", "texto": "Nadie. Igual que los programas electorales.", "inicio": 60.441, "fin": 63.078}]}